+// The emulated DAC idles at a constant DC offset instead of digital silence.
+// A DAC fed a constant non-zero signal never engages its zero-detect mute, so
+// USB/CPU noise becomes audible whenever the emulator is running. This 1-pole
+// high-pass (~2 Hz at 64 kHz) removes the offset; residuals smaller than one
+// 16-bit step are snapped to exact zero so idle output is true silence.
+AudioFrame<int32_t> Instance::RemoveDC(const AudioFrame<int32_t>& in)
+{
+    constexpr double R     = 0.9998;
+    constexpr double LSB16 = 32768.0; // one 16-bit step in the emulator's int32 domain
+
+    const double x[2] = {(double)in.left, (double)in.right};
+    int32_t      out[2];
+
+    for (int ch = 0; ch < 2; ++ch)
+    {
+        double y = x[ch] - m_dc_x[ch] + R * m_dc_y[ch];
+        if (std::fabs(y) < 1e-6)
+        {
+            y = 0.0; // avoid decaying into denormals
+        }
+        m_dc_x[ch] = x[ch];
+        m_dc_y[ch] = y;
+
+        if (std::fabs(y) < LSB16)
+        {
+            out[ch] = 0;
+        }
+        else
+        {
+            out[ch] = (int32_t)std::fmax(std::fmin(y, (double)INT32_MAX), (double)INT32_MIN);
+        }
+    }
+
+    return AudioFrame<int32_t>{.left = out[0], .right = out[1]};
+}
